{
  "id": "/",
  "name": "جوهر جروب - نظام الشيتات وإدارة العملاء CRM",
  "short_name": "جوهر CRM",
  "description": "منظومة إدارة العملاء والشيتات العقارية والمتابعات التلقائية لمجموعة جوهر للتطوير العقاري",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#f8fafc",
  "categories": ["business", "productivity"],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "contacts",
          "accept": ["text/vcard", "text/x-vcard", ".vcf"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
